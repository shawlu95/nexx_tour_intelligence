{
  "expo": {
    "name": "NORA",
    "slug": "nora",
    "scheme": "nora",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.nora.tours",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.nora.tours",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": "NORA records your spoken reaction to each home you visit.",
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "NORA suggests the address of the home you just visited."
        }
      ],
      "expo-notifications",
      "expo-apple-authentication",
      "expo-secure-store",
      "expo-sqlite",
      "expo-web-browser",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
